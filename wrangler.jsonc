{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "newcaval",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "8c88cabb-763a-45b9-854a-7785a0700a4e","database_name": "newcaval" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "9800a0b6b46847a580792d49f26a3abc" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
